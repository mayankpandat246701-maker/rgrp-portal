# Server-only production configuration. Never prefix secrets with NEXT_PUBLIC_.
# Configure every value in the hosting platform's protected environment settings.

# Neon PostgreSQL pooled runtime URL and direct migration URL.
DATABASE_URL=
DIRECT_URL=

# Session signing secret; use a unique random value with at least 32 characters.
AUTH_SECRET=

# Initial Super Admin bootstrap credentials; keep private and rotate after setup.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# Independent key for encrypted private document files (minimum 32 characters).
DOCUMENT_ENCRYPTION_KEY=

# Independent secret for signing and verifying public QR payloads (minimum 32 characters).
QR_SIGNING_SECRET=

# Canonical HTTPS origin for the deployed application.
APP_BASE_URL=

# Set by the hosting runtime; production configuration requires production.
NODE_ENV=
# Private encrypted document storage.
# Use "local" only for development. Production requires "supabase".
STORAGE_PROVIDER=local

# Required when STORAGE_PROVIDER=supabase. Keep real values only in .env or deployment settings.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=private-documents

# Shared rate limiting. Production requires Upstash Redis.
# Leave unset locally to use the development in-memory limiter.
RATE_LIMIT_PROVIDER=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=