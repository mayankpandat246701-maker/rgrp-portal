# Server-only configuration examples. Replace every placeholder with deployment-specific
# values in protected settings. Never prefix secrets with NEXT_PUBLIC_.

# PostgreSQL pooled runtime URL and direct migration URL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Replace with a unique random secret of at least 32 characters.
AUTH_SECRET=REPLACE_ME

# Initial Super Admin bootstrap credentials; keep private and rotate after setup.
ADMIN_BOOTSTRAP_EMAIL=admin@example.invalid
ADMIN_BOOTSTRAP_PASSWORD=REPLACE_ME

# Replace with a unique random key of at least 32 characters.
DOCUMENT_ENCRYPTION_KEY=REPLACE_ME

# Replace with a unique random secret of at least 32 characters.
QR_SIGNING_SECRET=REPLACE_ME

# Canonical HTTPS origin for the deployed application.
APP_BASE_URL=https://your-app.invalid

# Production configuration requires production.
NODE_ENV=production
# Private encrypted document storage.
# Use "local" only for development. Production requires "supabase" or "vercel-blob".
STORAGE_PROVIDER=supabase

# Required when STORAGE_PROVIDER=supabase.
SUPABASE_URL=https://your-project.supabase.invalid
SUPABASE_SECRET_KEY=REPLACE_ME
SUPABASE_STORAGE_BUCKET=REPLACE_ME

# Required when STORAGE_PROVIDER=vercel-blob.
# BLOB_READ_WRITE_TOKEN: read-write token of the PRIVATE Vercel Blob store
# (injected automatically as BLOB_READ_WRITE_TOKEN when the store is connected
# to the Vercel project; used for documents and other private files).
# BLOB_PUBLIC_READ_WRITE_TOKEN: token of the PUBLIC Vercel Blob store used only
# for Mukhya Vyakti portrait images; create the store with the environment
# variable prefix "BLOB_PUBLIC_" so its token is exposed under this name.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_REPLACE_ME
BLOB_PUBLIC_READ_WRITE_TOKEN=vercel_blob_rw_REPLACE_ME

# Shared rate limiting. Production requires Upstash Redis.
# Leave unset locally to use the development in-memory limiter.
RATE_LIMIT_PROVIDER=upstash
UPSTASH_REDIS_REST_URL=https://your-database.upstash.invalid
UPSTASH_REDIS_REST_TOKEN=REPLACE_ME