generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AdminRole {
  SUPER_ADMIN
  NATIONAL_ADMIN
  CONTENT_ADMIN
  VIEWER
}

enum AdminAuditAction {
  APPLICATION_APPROVED
  APPLICATION_BLOCKED
  DOCUMENTS_VERIFIED
  DOCUMENTS_REJECTED
  ID_CARD_TEMPLATE_UPLOADED
  QR_GENERATED
}

enum UploadStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum KaryakartaStatus {
  PENDING
  APPROVED
  BLOCKED
  REJECTED
  INACTIVE
}

enum KaryakartaApplicationStatus {
  PENDING
  APPROVED
  BLOCKED
}

enum NoticeStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Admin {
  id                   String                  @id @default(cuid())
  name                 String
  email                String                  @unique
  passwordHash         String
  role                 AdminRole               @default(SUPER_ADMIN)
  isActive             Boolean                 @default(true)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  activities           AdminActivity[]
  auditLogs            AdminAuditLog[]
  uploadedTemplates    IDCardTemplate[]
  verifiedApplications KaryakartaApplication[] @relation("ApplicationDocumentVerifier")
}

model Karyakarta {
  id          String           @id @default(cuid())
  regNo       String           @unique
  name        String
  phone       String           @unique
  email       String?          @unique
  designation String?
  state       String?
  zone        String?
  district    String?
  photoUrl    String?
  status      KaryakartaStatus @default(PENDING)
  approvedAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([regNo])
  @@index([phone])
  @@index([email])
  @@index([status])
  @@index([state])
  @@index([zone])
  @@index([district])
  @@index([createdAt])
}

model KaryakartaApplication {
  id                   String                      @id @default(cuid())
  applicationReference String                      @unique
  fullName             String
  fatherName           String
  motherName           String
  dateOfBirth          DateTime                    @db.Date
  gender               String
  category             String
  mobile               String
  alternateMobile      String?
  email                String?
  address              String
  pincode              String
  district             String
  state                String
  constituency         String
  education            String
  occupation           String
  organizationName     String?
  designation          String?
  joiningReason        String?
  socialMediaLinks     String?
  referenceBy          String?
  status               KaryakartaApplicationStatus @default(PENDING)
  photoPath            String?
  aadhaarPath          String?
  qrCodePath           String?
  uploadStatus         UploadStatus                @default(PENDING)
  documentReviewReason String?
  verifiedByAdminId    String?
  verifiedAt           DateTime?
  idCardGeneratedAt    DateTime?
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  verifiedByAdmin      Admin?                      @relation("ApplicationDocumentVerifier", fields: [verifiedByAdminId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([createdAt])
  @@index([mobile])
  @@index([uploadStatus])
}

model IDCardTemplate {
  id                String   @id @default(cuid())
  templatePath      String
  uploadedByAdminId String
  uploadedAt        DateTime @default(now())
  isActive          Boolean  @default(true)
  uploadedByAdmin   Admin    @relation(fields: [uploadedByAdminId], references: [id], onDelete: Restrict)

  @@index([isActive])
  @@index([uploadedAt])
}

model AdminAuditLog {
  id            String           @id @default(cuid())
  adminId       String
  action        AdminAuditAction
  applicationId String?
  metadata      Json?
  createdAt     DateTime         @default(now())
  admin         Admin            @relation(fields: [adminId], references: [id], onDelete: Restrict)

  @@index([adminId])
  @@index([applicationId])
  @@index([createdAt])
}

model Notice {
  id          String       @id @default(cuid())
  title       String
  content     String
  isFeatured  Boolean      @default(false)
  status      NoticeStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status])
  @@index([publishedAt])
}

model SiteContent {
  id        String   @id @default(cuid())
  key       String   @unique
  title     String?
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LeadershipMessage {
  id          String   @id @default(cuid())
  name        String
  designation String
  message     String
  portraitUrl String?
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished, sortOrder])
}

model AdminActivity {
  id        String   @id @default(cuid())
  adminId   String?
  action    String
  entity    String?
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())
  admin     Admin?   @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([adminId])
  @@index([createdAt])
}
